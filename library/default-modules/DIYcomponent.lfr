// DIYcomponent — built-in black-box placeholder for user-designed parts.
//
// Call with size / keepout parameters (µm) and four clockwise sides. Unused sides = None:
//
//   DIYcomponent #(length=10000, width=8000, height=2000) box(
//       .up(inlet),
//       .right(None),
//       .down(outlet),
//       .left(None)
//   );
//
// Optional keepout halo around the box (same meaning as MINT componentSpacing).
// Default is 1000 µm. Override per instance, for example:
//   DIYcomponent #(length=10000, width=8000, height=2000, componentSpacing=3000) box(...);
//
// Sides map to physical terminals: up=1, right=2, down=3, left=4.
// Do not label ports as finput/foutput — direction is inferred from the bound nets.
// Neptune/Fluigi use length/width/height/componentSpacing + terminals only (no internal geometry).
//
// Import the module with a backtick-import of library/DIYcomponent.lfr first.
module DIYcomponent(
    finput up, right,
    foutput down, left
);
    #MAP "DIYCOMPONENT" "~"
    #CONSTRAIN "~" length = 5000
    #CONSTRAIN "~" width = 5000
    #CONSTRAIN "~" height = 250
    #CONSTRAIN "~" componentSpacing = 1000
    // Seed assign so #MAP attaches; parent instances use instantiate_diy_component.
    // Standalone compile wires all four sides (up=1, right=2, down=3, left=4).
    assign down = ~up;
endmodule
